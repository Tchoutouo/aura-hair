# Mot de passe de la page /admin (obligatoire)
ADMIN_PASSWORD=
# Secret de signature des sessions admin (facultatif, une longue chaîne aléatoire)
ADMIN_SECRET=

# Stockage des prix et des commandes : ajoutés automatiquement par l'intégration
# Upstash Redis de Vercel (Storage → Marketplace → Upstash → Redis).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# E-mails de commande (facultatif) : clé API Resend (resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les commandes (modifiable aussi dans /admin)
ORDER_EMAIL_TO=
# Expéditeur. Pour envoyer une copie au client, il faut un domaine vérifié chez Resend,
# ex. "Aura Hair <commandes@votre-domaine.com>". Sans domaine, laissez vide.
RESEND_FROM=
